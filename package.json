{
  "name": "laya-player",
  "version": "1.0.0",
  "description": "A multi-mode 2048 arcade with human, JEV, LLM, and local Laya play",
  "license": "ISC",
  "author": "",
  "type": "module",
  "main": "dist-server/server/index.js",
  "scripts": {
    "dev": "concurrently \"tsx watch server/index.ts\" \"vite\" \"node scripts/start-laya.mjs\"",
    "setup:laya": "python3 -m venv .venv && .venv/bin/python -m pip install 'laya[serve]==0.3.20'",
    "laya": "node scripts/start-laya.mjs --required",
    "build": "npm run typecheck && vite build && tsc -p tsconfig.server.json",
    "start": "node dist-server/server/index.js",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "check:models": "node scripts/check-models.mjs",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.3",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@openrouter/sdk": "^1.3.32",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "zod": "^4.6.5"
  }
}
