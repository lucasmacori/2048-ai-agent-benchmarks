# Server
PORT=3000

# OpenRouter (required only for JEV and LLM modes)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=~typesafe/jev-latest

# Agent run limits and autoplay delays
MAX_TURNS=2000
RECENT_MOVES_LIMIT=5
AGENT_DELAY_FAST_MS=350
AGENT_DELAY_MS=850
AGENT_DELAY_SLOW_MS=1600

# LLM structured decision settings
LLM_REASON_MAX_LENGTH=160
LLM_REQUIRE_PARAMETERS=true
SYSTEM2_PROBABILITY_MARGIN=0.15
SYSTEM2_CONFIDENCE_THRESHOLD=0.6
LLM_INSTRUCTIONS=Play 2048. Pick the strongest move using the board and simulated move outcomes. Return a concise reason. Only choose one of the legal moves.
JEV_INSTRUCTIONS=Choose the legal move most likely to survive and eventually create 2048. Prefer preserving empty cells and keeping the largest tile in a corner; use immediate score secondarily.

# Local Laya sidecar and decision settings
LAYA_BASE_URL=http://127.0.0.1:8000
LAYA_API_KEY=
LAYA_PORT=8000
LAYA_DEVICE=cpu
LAYA_PRELOAD=1
LAYA_MODEL=english
LAYA_INSTRUCTIONS=Choose the legal 2048 move most likely to preserve open space and create 2048. Keep the largest tile in a corner when possible.

# Sidecar health check
CAPABILITIES_TIMEOUT_MS=1200
