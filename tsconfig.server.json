{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "outDir": "dist-server",
    "rootDir": ".",
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/game/**/*.ts", "src/history/types.ts", "src/agent/runtime-config.ts", "src/agent/reasoning.ts", "src/agent/decision-output.ts"],
  "exclude": ["server/**/*.test.ts"]
}
